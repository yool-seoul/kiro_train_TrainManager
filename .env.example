# === Train Manager 환경변수 예시 ===
# 실제 값으로 채운 뒤 파일명을 .env 로 복사해서 사용하세요.
# 모든 키는 TRAINMGR_ 접두사를 사용합니다.

# --- 기본 ---
TRAINMGR_DEBUG=true
# 운영에서는 반드시 랜덤 값으로 교체 (예: python -c "import secrets;print(secrets.token_hex(32))")
TRAINMGR_SESSION_SECRET=change-me

# 데이터 소스: mock(가짜 데이터) | live(실제 Korail/SRT)
TRAINMGR_DATA_SOURCE=mock

# --- 자동 예약대기(watch) ---
TRAINMGR_WATCH_POLL_INTERVAL_SEC=30
TRAINMGR_WATCH_MAX_DURATION_SEC=1800
TRAINMGR_WATCH_MAX_JOBS=5

# --- Google Sheets 자격증명 ---
# credential_source: service_account | csv_url | disabled
TRAINMGR_CREDENTIAL_SOURCE=disabled
# service_account 방식일 때:
# TRAINMGR_GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
# TRAINMGR_GOOGLE_SPREADSHEET_ID=1AbcD...xyz
# TRAINMGR_GOOGLE_WORKSHEET_NAME=credentials
# csv_url 방식일 때:
# TRAINMGR_GOOGLE_CSV_URL=https://docs.google.com/spreadsheets/d/xxx/export?format=csv&gid=0
